# Entornos virtuales y paquetes
.venv/
venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
backend/.pytest_cache/
.ruff_cache/

# Variables de entorno privadas
.env
backend/.env

# Datasets de imagenes y manifiestos pesados (se conserva reporte de curaduria)
backend/dataset/*
!backend/dataset/reporte_curaduria.json
backend/engine/data/manifest*.csv
backend/engine/data/manifiesto*.csv
backend/runtime/

# MLflow y Bases de Datos Locales
mlruns/
mlartifacts/
*.db
*.sqlite
*.sqlite3

# Modelos entrenados pesados (se conservan modelos INT8 ligeros de 4.5 MB y metadatos JSON)
backend/models/*.pth
backend/models/*.pt
backend/models/*.keras
backend/models/*.h5
backend/models/*_fp32.onnx
!backend/models/plagia_mobile_int8.onnx
!backend/models/plagia_campo_hoja_int8.onnx
!backend/models/*.json

# Flutter / Android Studio build artifacts
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties
*.apk
*.aab
