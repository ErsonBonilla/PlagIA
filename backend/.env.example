# ============================================================================
# PLAGIA ENTERPRISE - CONFIGURACION DE ENTORNO
# Vigilancia Fitosanitaria Multinivel para el Cultivo de Arroz en el Tolima
# ============================================================================

# --- Entorno General ---
PLAGIA_ENV=production
PLAGIA_APP_NAME="PlagIA Enterprise API"
PLAGIA_VERSION="1.0.0"

# --- Seguridad & Autenticacion JWT ---
PLAGIA_SECRET_KEY="plagia-tolima-enterprise-secret-key-change-in-prod-2026"
PLAGIA_JWT_ALGORITHM="HS256"
PLAGIA_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Rutas de Datasets y Artefactos ---
PLAGIA_DATASET_ROOT="./dataset"
PLAGIA_MODELS_DIR="./models"
PLAGIA_ARTIFACTS_DIR="./artifacts"
PLAGIA_STORAGE_LOCAL_DIR="./storage_local"

# --- Motor de IA e Inferencia (CUDA / ONNX / PyTorch / YOLO) ---
# Modos soportados: onnx | pytorch | mlflow
PLAGIA_MODEL_SOURCE="onnx"
PLAGIA_USE_CUDA=true
PLAGIA_AMP_FP16=true
PLAGIA_BATCH_SIZE=16
PLAGIA_GRAD_ACCUM_STEPS=2
PLAGIA_SUBSET_PER_CLASS=300

# --- MLflow Tracking & Model Registry ---
PLAGIA_MLFLOW_URI="sqlite:///./mlflow.db"
PLAGIA_MLFLOW_EXPERIMENT="PlagIA_Tolima_Fitosanitario"
PLAGIA_MLFLOW_MODEL_NAME="plagia_rice_classifier"
PLAGIA_MLFLOW_STAGE="Staging"

# --- Base de Datos Geoespacial (PostgreSQL + PostGIS Principal / Respaldo SQLite) ---
PLAGIA_DATABASE_URL="postgresql+psycopg2://plagia:plagia_secret@localhost:5432/plagia_geo"
PLAGIA_SQLITE_FALLBACK_URL="sqlite:///./plagia_enterprise.db"

# --- Procesamiento Asincrono (Celery + Redis) ---
PLAGIA_REDIS_URL="redis://localhost:6379/0"
PLAGIA_CELERY_EAGER_FALLBACK=true

# --- Almacenamiento de Objetos (MinIO / S3) ---
PLAGIA_MINIO_ENDPOINT="localhost:9000"
PLAGIA_MINIO_ACCESS_KEY="plagia_admin"
PLAGIA_MINIO_SECRET_KEY="plagia_minio_secret"
PLAGIA_MINIO_BUCKET="plagia-tolima-orthomosaics"
PLAGIA_MINIO_SECURE=false
